# Copy this file to .env for local development. .env itself is gitignored.

# Set False (and provide a real SECRET_KEY) for any non-local environment.
DEBUG=True

# Required when DEBUG=False. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Optional: comma-separated. Defaults to localhost,127.0.0.1 in non-DEBUG.
# ALLOWED_HOSTS=

# Optional: leave DB_ENGINE blank to use SQLite at db.sqlite3.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=alpha_pos
# DB_USER=alpha_pos
# DB_PASSWORD=
# DB_HOST=db
# DB_PORT=5432

# Optional: enable Redis-backed cache. Without this, in-memory cache is used
# (per-worker, so multi-worker deployments must enable Redis).
# USE_REDIS=True
# REDIS_URL=redis://127.0.0.1:6379/0

# Optional: comma-separated CORS origins. In DEBUG with no value, all origins
# are allowed (without credentials). In production, set explicitly.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Optional: AI assistant in the stock module.
# GEMINI_API_KEY=

# Sync (only needed if you operate a multi-branch deployment).
# CLOUD_SYNC_TOKEN=
# SYNC_MANAGEMENT_TOKEN=

# Trust X-Forwarded-* headers from a reverse proxy. Off by default so
# attackers can't spoof IPs / protocols when there's no proxy in front.
# TRUST_FORWARDED_PROTO=True
# TRUST_FORWARDED_FOR=True

# HR file upload caps (bytes). Default 10 MiB.
# DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
# FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

# Logging
# LOG_DIR=logs
# LOG_LEVEL=INFO

# Telegram bot (notifications app)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# Licensing — required for the kill switch to clear UNREGISTERED. The
# control center URL must be https:// when DEBUG=False (boot fails
# otherwise). LICENSE_FERNET_KEY can be generated with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LICENSE_CONTROL_CENTER_URL=https://control.example.com
# LICENSE_FERNET_KEY=
# LICENSE_HEARTBEAT_INTERVAL=300
# LICENSE_GRACE_DAYS=7
# LICENSE_HTTP_TIMEOUT_S=10
# LICENSE_STATE_CACHE_TTL=60
# LICENSE_BACKOFF_SCHEDULE_S=300,900,3600
#
# DEVELOPMENT ONLY — bypass licensing entirely. With this on (and DEBUG=True)
# the kill switch is disabled: alpha_pos runs with no control center, no
# heartbeat, and nothing to pay. Only honored when DEBUG=True, so it is dead in
# a production build (DEBUG=False) — a customer cannot use it to dodge billing.
# Set DEBUG=True too for it to take effect. NEVER ship with this on.
# LICENSE_DEV_BYPASS=true
#
# (Optional) silence the heartbeat daemon while developing with the bypass:
# LICENSE_HEARTBEAT_DISABLED=1
